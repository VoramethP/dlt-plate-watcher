# เลือกอย่างใดอย่างหนึ่ง (มีทั้งคู่ → ใช้ bot)

# โหมด bot — มีปุ่มใต้ข้อความ (วิธีสร้างอยู่ใน README › โหมด bot)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# โหมด webhook — ตั้งง่ายที่สุด ไม่มีปุ่ม
# Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
