# ---------- โหมด Vercel (ปุ่ม + cron · ADR-0005) — ตั้งใน Vercel › Settings › Environment Variables ----------
# Discord Developer Portal › Bot › Reset Token
DISCORD_BOT_TOKEN=
# ช่องที่ให้ bot โพสต์ (Developer Mode → คลิกขวาช่อง → Copy Channel ID)
DISCORD_CHANNEL_ID=
# Developer Portal › General Information › Public Key (ใช้ตรวจลายเซ็นทุก request ที่ Discord ยิงมา)
DISCORD_PUBLIC_KEY=
# Application ID (หน้าเดียวกัน) — ใช้แค่ตอน `npm run register` ลงทะเบียน /panel
DISCORD_APP_ID=
# (ทางเลือก) server id → /panel มีผลทันที · ไม่ใส่ = global รอถึง 1 ชม.
DISCORD_GUILD_ID=

# Postgres ตัวไหนก็ได้ (แนะนำ Neon ฟรี) — Neon › Connect › Connection pooling เปิด (host มี -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# (ทางเลือก) ตัวไม่ผ่าน pooler สำหรับ `npm run db:migrate` — ไม่ใส่จะใช้ DATABASE_URL
DIRECT_DATABASE_URL=
# (ชั่วคราว) Postgres ตัวเก่าตอนย้ายผู้ให้บริการ → `npm run db:copy` แล้วลบทิ้ง
# OLD_DATABASE_URL=

# สุ่มยาว ๆ (`openssl rand -hex 32`) — Vercel Cron ใส่ header ให้เอง · cron-job.org ต้องตั้ง Authorization: Bearer <ค่านี้>
CRON_SECRET=

# (ทางเลือก) 'all' = cron 09:30 กวาดข้อความของ "ทุกคน" ในช่องก่อนโพสต์การ์ดประจำวัน (ต้องให้สิทธิ์ Manage Messages กับ bot)
# ไม่ใส่ / ค่าอื่น = กวาดเฉพาะข้อความของ bot เอง · ปิดฟีเจอร์นี้ได้ทันทีโดยลบค่านี้ทิ้ง
DAILY_SWEEP=

# เนื้อหา watch.config.json ทั้งไฟล์ (บรรทัดเดียว) — wishlist.numbers/exclude ในนี้เป็นแค่ค่าเริ่มต้น ปุ่มแก้ผ่านฐานข้อมูล
WATCH_CONFIG_JSON=

# ---------- โหมดบนเครื่อง (CLI · webhook · ไม่มีปุ่ม) ----------
# Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# (ทางเลือก) จำนวนปุ่มต่อแถว 1–5 · ค่าเริ่มต้น 5 = แถวเดียว · Discord ยืดปุ่มเต็มแถวไม่ได้ แยกแถวแล้วขอบไม่ตรงกัน
# DISCORD_BUTTONS_PER_ROW=2
