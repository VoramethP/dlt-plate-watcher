{
  "name": "dlt-plate-watcher",
  "version": "0.4.0",
  "description": "เฝ้าตารางเปิดจองเลขทะเบียนรถของกรมการขนส่งทางบก แล้วแจ้งเตือนผ่าน Discord (แจ้งเตือนอย่างเดียว ไม่จองแทน)",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "check": "node --env-file-if-exists=.env --import tsx src/cli.ts check",
    "schedule": "node --env-file-if-exists=.env --import tsx src/cli.ts schedule",
    "match": "node --env-file-if-exists=.env --import tsx src/cli.ts match",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "register": "node --env-file-if-exists=.env --import tsx scripts/register-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:import": "node --env-file-if-exists=.env --import tsx scripts/import-local.ts",
    "db:copy": "node --env-file-if-exists=.env --import tsx scripts/copy-db.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "bin": {
    "dlt-plate-watcher": "dist/src/cli.js"
  }
}
